{
  "version": 6,
  "include": [
    "CMakePresets.json"
  ],
  "configurePresets": [
    {
      "name": "local-windows-x64",
      "displayName": "Local Windows x64",
      "inherits": "windows-x64",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "C:/path/to/vcpkg/scripts/buildsystems/vcpkg.cmake"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "local-debug",
      "displayName": "Local Debug",
      "configurePreset": "local-windows-x64",
      "configuration": "Debug"
    },
    {
      "name": "local-editor",
      "displayName": "Local Editor",
      "configurePreset": "local-windows-x64",
      "configuration": "Editor"
    },
    {
      "name": "local-release",
      "displayName": "Local Release",
      "configurePreset": "local-windows-x64",
      "configuration": "Release"
    }
  ]
}
