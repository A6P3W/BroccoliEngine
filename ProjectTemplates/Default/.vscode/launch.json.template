{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "GDB: {PROJECT_NAME} (active CMake preset)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${input:gameExe}",
      "cwd": "${input:gameDir}",
      "args": [],
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "C:/msys64/mingw64/bin/gdb.exe",
      "setupCommands": [
        {
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ],
  "inputs": [
    {
      "id": "gameExe",
      "type": "command",
      "command": "cmake.launchTargetPath",
      "args": {
        "targetName": "{PROJECT_NAME}"
      }
    },
    {
      "id": "gameDir",
      "type": "command",
      "command": "cmake.getLaunchTargetDirectory",
      "args": {
        "targetName": "{PROJECT_NAME}"
      }
    }
  ]
}
