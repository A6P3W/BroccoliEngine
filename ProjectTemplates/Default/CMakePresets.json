{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 2,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Windows x64",
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/build/windows-x64",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
        "VCPKG_MANIFEST_DIR": "${sourceDir}/BroccoliEngine/Engine"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "windows-x64",
      "configuration": "Debug"
    },
    {
      "name": "editor",
      "configurePreset": "windows-x64",
      "configuration": "Editor"
    },
    {
      "name": "release",
      "configurePreset": "windows-x64",
      "configuration": "Release"
    },
    {
      "name": "local-debug",
      "configurePreset": "windows-x64",
      "configuration": "Debug"
    },
    {
      "name": "local-editor",
      "configurePreset": "windows-x64",
      "configuration": "Editor"
    },
    {
      "name": "local-release",
      "configurePreset": "windows-x64",
      "configuration": "Release"
    }
  ]
}
