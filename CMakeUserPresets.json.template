{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-x64-local",
      "displayName": "Windows x64 Local",
      "description": "Visual Studio 2026 / MSVC / local vcpkg override",
      "inherits": "windows-x64",
      "environment": {
        "VCPKG_ROOT": "{YOUR_VCPKG_ROOT_DIRECTORY}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug-local",
      "inherits": "debug",
      "configurePreset": "windows-x64-local"
    },
    {
      "name": "editor-local",
      "inherits": "editor",
      "configurePreset": "windows-x64-local"
    },
    {
      "name": "release-local",
      "inherits": "release",
      "configurePreset": "windows-x64-local"
    }
  ]
}
